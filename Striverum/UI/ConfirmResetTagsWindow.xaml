<Window x:Class="Striverum.UI.ConfirmResetTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        Title="Reset All Tags - Confirmation"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Width="460"
        Background="#181818" ShowActivated="True" SizeToContent="Height">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8" Background="#2A1515" BorderBrush="#5C1D1D" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <fa5:ImageAwesome Icon="Solid_ExclamationTriangle" Height="14" Width="14" Foreground="#EF5350" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#F2F2F2" Text="Reset All Mod Tags"/>
                    <TextBlock FontSize="11" Foreground="#888888" Text="Action requires confirmation"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Warning Content -->
        <Border Grid.Row="1" Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Text="Are you sure you want to reset all mod tags?" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" LineHeight="17"
                           Text="All custom tags across all installed mods will be replaced with their default categories (from GameBanana or mod metadata). This cannot be undone."/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cancel Button -->
            <Button Grid.Column="0" Name="NoButton" Height="34" Cursor="Hand" Click="NoButton_Click" IsCancel="True">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="#262626" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <fa5:ImageAwesome Icon="Solid_Times" Height="11" Width="11" Foreground="#AAAAAA" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancel" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Yes, Reset Button - Painted Red -->
            <Button Grid.Column="2" Name="YesButton" Height="34" Cursor="Hand" Click="YesButton_Click" IsDefault="True">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="#C62828" BorderBrush="#E53935" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <fa5:ImageAwesome Icon="Solid_Check" Height="11" Width="11" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                <TextBlock Text="Yes, Reset" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5350"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C62828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>

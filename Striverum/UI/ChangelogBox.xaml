<Window x:Class="Striverum.UI.ChangelogBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Striverum"
        Title="Striverum Changelog"
        Background="#181818" ShowActivated="True" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:CategoryColorConverter x:Key="CategoryColorConverter"/>
        <Style x:Key="ChangelogButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="85"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChangelogPrimaryButton" TargetType="Button" BasedOn="{StaticResource ChangelogButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="Text" Padding="6" Foreground="#F2F2F2" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" FontSize="15"/>
        <Label Grid.Row="2" x:Name="VersionLabel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#CCCCCC"/>
        <Image Grid.Row="1" Name="PreviewImage" HorizontalAlignment="Center" Width="350" Margin="0,8" Visibility="Collapsed"/>
        <DataGrid Grid.Row="3" x:Name="ChangesGrid" HorizontalAlignment="Center" Margin="10,4,10,10" RowBackground="#222222" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="1" Foreground="#F2F2F2" 
                  VerticalAlignment="Center" FontSize="13" HeadersVisibility="None" AutoGenerateColumns="False" VerticalScrollBarVisibility="Auto" MaxHeight="150"
                  HorizontalScrollBarVisibility="Disabled" GridLinesVisibility="None" VerticalContentAlignment="Top">
            <DataGrid.Columns>
                <DataGridTemplateColumn IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#333333" CornerRadius="4" Padding="6,2" Margin="4,2">
                                <TextBlock Text="{Binding Category}" Foreground="{Binding Category, Converter={StaticResource CategoryColorConverter}}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Binding="{Binding Text}" MaxWidth="320">
                    <DataGridTextColumn.ElementStyle>
                        <Style>
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                            <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                            <Setter Property="TextBlock.Foreground" Value="#E0E0E0" />
                            <Setter Property="TextBlock.Margin" Value="6,2" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="MinHeight" Value="28"/>
                    <Setter Property="Background" Value="#222222"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <ScrollViewer Grid.Row="4" MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <TextBlock MaxWidth="500" Name="UpdateText" Padding="10" Foreground="#CCCCCC" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
        </ScrollViewer>
        <TextBlock MaxWidth="500" Grid.Row="5" Padding="8" Foreground="#F2F2F2" FontWeight="SemiBold" TextAlignment="Center" Text="Would you like to update?" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="14"/>
        <Grid Grid.Row="6" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="YesButton" Content="Yes" Style="{StaticResource ChangelogPrimaryButton}" VerticalAlignment="Center" HorizontalAlignment="Center" Click="YesButton_Click" IsDefault="True" Grid.Column="0"/>
            <Button x:Name="NoButton" Content="No" Style="{StaticResource ChangelogButton}" VerticalAlignment="Center" HorizontalAlignment="Center" Click="NoButton_Click" Grid.Column="1"/>
            <Button x:Name="SkipButton" Visibility="Collapsed" Content="Skip" Style="{StaticResource ChangelogButton}" VerticalAlignment="Center" HorizontalAlignment="Center" Click="Skip_Button_Click" Grid.Column="2"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Striverum.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Striverum"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d" Background="#181818" ResizeMode="NoResize"
        Title="Install Mod - Confirmation" SizeToContent="Height" Width="460">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa5:ImageAwesome Icon="Solid_CloudDownloadAlt" Height="15" Width="15" Foreground="#D32F2F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#F2F2F2" Text="Install Mod" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mod Title & Submitter Info -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="ModTitleBlock" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <fa5:ImageAwesome Icon="Solid_User" Height="11" Width="11" Foreground="#888888" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubmitterBlock" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Preview Image inside rounded border -->
        <Border Grid.Row="2" CornerRadius="8" Background="#121212" BorderBrush="#333333" BorderThickness="1" MaxHeight="220" Margin="0,0,0,14" ClipToBounds="True">
            <Image x:Name="Preview" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- Prompt -->
        <TextBlock Grid.Row="3" Text="Would you like to download and install this mod?" FontSize="13" Foreground="#CCCCCC" TextAlignment="Center" Margin="0,0,0,16"/>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Height="36" Margin="0,0,10,0" Cursor="Hand" Click="No_Click" IsCancel="True">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Border" Background="#222222" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <fa5:ImageAwesome Icon="Solid_Times" Height="11" Width="11" Foreground="#A0A0A0" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cancel" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#303030"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#555555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="InstallButton" Height="36" Cursor="Hand" Click="Yes_Click" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Border" Background="#D32F2F" BorderThickness="0" CornerRadius="8" Padding="18,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <fa5:ImageAwesome Icon="Solid_Download" Height="12" Width="12" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                    <TextBlock Text="Install Mod" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#E53935"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#B71C1C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

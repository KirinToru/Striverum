<Window x:Class="Striverum.UI.ConfigurePaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Striverum.UI"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        Title="Configure Paks" WindowStartupLocation="CenterScreen"
        MinWidth="520" Width="600" Height="480" MinHeight="380"
        Background="#181818" ShowActivated="True">
    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
        <local:PathNameConverter x:Key="PathNameConverter"/>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="PakToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd" Background="#303030" BorderBrush="#424242" BorderThickness="1" CornerRadius="13" Padding="8,2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <fa5:ImageAwesome x:Name="Ico" Icon="Solid_Times" Height="10" Width="10" Foreground="#888888" Margin="0,0,5,0"/>
                                <TextBlock x:Name="Txt" Text="Disabled" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E7D32"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="Ico" Property="Icon" Value="Solid_Check"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Txt" Property="Text" Value="Enabled"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PakTemplate">
            <Border Background="#252525" BorderBrush="#353535" BorderThickness="1" CornerRadius="8" Margin="2,3" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Pak icon -->
                    <fa5:ImageAwesome Grid.Column="0" Icon="Solid_Box" Height="15" Width="15" Foreground="#D32F2F" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <!-- Pak Name & Relative Path -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                        <TextBlock Text="{Binding Key, Mode=OneWay, Converter={StaticResource FileNameConverter}}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Key, Mode=OneWay, Converter={StaticResource PathNameConverter}}"
                                   FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Toggle Button -->
                    <ToggleButton Grid.Column="2" Style="{StaticResource PakToggleSwitchStyle}"
                                  IsChecked="{Binding Value, Mode=OneWay}" Click="ToggleButton_Click"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa5:ImageAwesome Icon="Solid_Cogs" Height="16" Width="16" Foreground="#D32F2F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="#F2F2F2" Text="Configure Mod Packages" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Target Info -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Target Mod" FontSize="11" FontWeight="SemiBold" Foreground="#888888" Margin="1,0,0,2"/>
            <TextBlock x:Name="ModNameBlock" FontSize="13" FontWeight="Bold" Foreground="#F2F2F2" TextWrapping="Wrap"/>
            <TextBlock x:Name="PakCountBlock" FontSize="11" Foreground="#AAAAAA" Margin="1,3,0,0"/>
        </StackPanel>

        <!-- List of paks -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,14">
            <ListView Name="PakList" Background="Transparent" BorderThickness="0"
                      ItemTemplate="{StaticResource PakTemplate}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3">
            <TextBlock Text="Changes apply immediately on mod rebuild" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
            <Button Name="CloseButton" Height="34" HorizontalAlignment="Right" Cursor="Hand" Click="CloseButton_Click" IsDefault="True" IsCancel="True">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Background="#222222" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="20,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <fa5:ImageAwesome Icon="Solid_Check" Height="11" Width="11" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="Close" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2C2C2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>

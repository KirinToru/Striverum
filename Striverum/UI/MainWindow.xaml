<Window x:Class="Striverum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:local="clr-namespace:Striverum"
        Background="#131313"
        Title="Striverum" SizeChanged="OnResize"
        mc:Ignorable="d" Closing="Window_Closing" WindowStartupLocation="CenterScreen"
        Height="750" Width="1280" MinHeight="750" MinWidth="1280" Loaded="WindowLoaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <FontFamily x:Key="Monospace">../Assets/#Roboto Mono</FontFamily>

        <!-- Smooth scrolling for all ScrollViewers, ListBoxes, and RichTextBoxes -->
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="local:SmoothScrollHelper.IsEnabled" Value="True"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="local:SmoothScrollHelper.IsEnabled" Value="True"/>
        </Style>
        <Style TargetType="{x:Type RichTextBox}">
            <Setter Property="local:SmoothScrollHelper.IsEnabled" Value="True"/>
        </Style>

        <!-- Compact Rounded / Pill Button Style -->
        <Style x:Key="RoundedTopButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Launch Button Style -->
        <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedTopButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#388E3C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#81C784"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Danger Button Style (e.g. Reset Tags) -->
        <Style x:Key="RedDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedTopButton}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#E53935"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF5350"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C62828"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu Styles with Smooth Fade/Slide Animation -->
        <Style x:Key="ModernModContextMenu" TargetType="{x:Type ContextMenu}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border x:Name="ContextMenuBorder"
                                Background="#202020"
                                BorderBrush="#383838"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MenuTranslate" Y="-6"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="ContextMenu.Opened">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContextMenuBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="MenuTranslate"
                                                         Storyboard.TargetProperty="Y"
                                                         From="-6" To="0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernContextMenuItem" TargetType="{x:Type MenuItem}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="8,4" Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" Margin="6,0,12,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#323232"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernContextMenuSeparator" TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{TemplateBinding Background}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Rounded ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border" CornerRadius="14" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#A0A0A0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#555555"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#777777"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="RoundedTopComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="10,0,24,0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F2F2F2"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#383838"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#454545"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#222222"
                                            BorderBrush="#444444"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,4">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="28"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Mod Enable Checkbox Style -->
        <Style x:Key="ModEnableCheckStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Circle" Width="16" Height="16" CornerRadius="8"
                                Background="#2A2A2A" BorderBrush="#4A4A4A" BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#E53935"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NSFW Toggle Pill Button Style -->
        <Style x:Key="NsfwPillStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Bd" Height="28" CornerRadius="14" Background="#222222"
                                BorderBrush="#383838" BorderThickness="1" Padding="10,2" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Txt" Text="NSFW" FontWeight="Bold" FontSize="11"
                                       Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E53935"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Icon Button Style -->
        <Style x:Key="RoundIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Hyperlink Style -->
        <Style TargetType="{x:Type Hyperlink}">
            <Setter Property="Foreground" Value="#E53935"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF5252"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ModTemplate">
            <Border CornerRadius="8" Margin="5" Cursor="Hand" PreviewMouseLeftButtonUp="ModTile_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#121212"/>
                        <Setter Property="BorderBrush" Value="#222222"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="BorderBrush" Value="#444444"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid VerticalAlignment="Center" x:Name="GridItem" Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Panel.ZIndex="4" FontSize="40" FontWeight="Medium" HorizontalAlignment="Center" Foreground="#f2f2f2">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSpoiler}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="SPOILER"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Rectangle Height="172" Panel.ZIndex="3" Fill="#202020" Opacity="0.99" Stretch="UniformToFill" Margin="5,10,5,5" VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="{x:Type Rectangle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSpoiler}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Image Margin="5,10,5,5" Source="{Binding Path=Image,Mode=OneWay,IsAsync=True}" Height="168" Panel.ZIndex="2"  VerticalAlignment="Center" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="5" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsSpoiler}" Value="False">
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=IsNsfw}" Value="True">
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <!-- Installed indicator badge: Green circle with white checkmark on top-left of preview -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,15,0,0" Panel.ZIndex="5"
                            Background="#2E7D32" BorderBrush="#81C784" BorderThickness="1" CornerRadius="12" Width="24" Height="24"
                            Visibility="{Binding IsInstalled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                            ToolTip="Mod is installed in Striverum">
                        <fa5:ImageAwesome Icon="Solid_Check" Height="11" Width="11" Foreground="#FFFFFF"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- 18+ badge on top right of preview for NSFW mods -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,12,0" Panel.ZIndex="5"
                            Background="#D32F2F" CornerRadius="10" MinWidth="22" Height="20" Padding="4,0"
                            Visibility="{Binding IsNsfw, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="18+" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Rectangle Height="168" Panel.ZIndex="1" Fill="Black" Stretch="UniformToFill" Margin="5,10,5,5" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding Path=Image,Mode=OneWay,IsAsync=True}"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock x:Name="Title" Margin="5" Grid.Row="1" FontWeight="Medium" TextTrimming="WordEllipsis" Background="Transparent" VerticalAlignment="Center"  Foreground="#f2f2f2" Text="{Binding Path=Title}"/>
                    <Popup PlacementTarget="{Binding ElementName=Title}" IsOpen="{Binding IsMouseDirectlyOver, ElementName=Title, Mode=OneWay}" AllowsTransparency="True">
                        <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.Background>
                            <TextBlock Margin="10" Text="{Binding Path=Title}" Foreground="#f2f2f2" FontWeight="Medium" FontSize="18" VerticalAlignment="Center" />
                        </Border>
                    </Popup>
                    <fa5:ImageAwesome Name="LoadingBar" Foreground="#D32F2F" Grid.Row="0" Icon="Solid_Spinner" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                    <StackPanel Grid.Row="2" Margin="10,-5,10,5" Orientation="Horizontal">
                        <Image VerticalAlignment="Center" Source="{Binding Path=Owner.Avatar}" Margin="0,0,10,0" Height="35"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#909090" Text="{Binding Path=Owner.Name}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Owner.HasUpic}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image VerticalAlignment="Center" Source="{Binding Path=Owner.Upic}" Height="25"/>
                    </StackPanel>
                    <Grid Name="CatGrid" HorizontalAlignment="Center" Grid.Row="5" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image Name="CatIcon" Grid.Column="0" VerticalAlignment="Center" Source="{Binding Path=Category.Icon}" Margin="0,0,10,0" Stretch="Uniform" Height="35" Width="35"/>
                        <TextBlock Name="CatText" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=CategoryName}" TextTrimming="WordEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=Category.HasIcon}" Value="False">
                                            <Setter Property="Grid.Column" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Popup PlacementTarget="{Binding ElementName=CatGrid}" HorizontalAlignment="Center" AllowsTransparency="True">
                            <Popup.Style>
                                <Style TargetType="Popup">
                                    <Setter Property="IsOpen" Value="True"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=CatGrid}" Value="False"/>
                                                <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=CatIcon}" Value="False" />
                                                <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=CatText}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsOpen" Value="False"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Popup.Style>
                            <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#101010" Opacity="0.9"/>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <SolidColorBrush Color="#101010" Opacity="0.9"/>
                                </Border.Background>
                                <Grid HorizontalAlignment="Center" Margin="10" Grid.Row="5" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" VerticalAlignment="Center" Source="{Binding Path=Category.Icon}" Margin="0,0,10,0" Stretch="Uniform" Height="35" />
                                    <TextBlock Grid.ColumnSpan="2" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#f2f2f2" Text="{Binding Path=CategoryName}" >
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=Category.HasIcon}" Value="True">
                                                        <Setter Property="Grid.Column" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Popup MaxWidth="400" PlacementTarget="{Binding ElementName=Desc}" AllowsTransparency="True">
                        <Popup.Style>
                            <Style TargetType="Popup">
                                <Setter Property="IsOpen" Value="False"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=Desc, Mode=OneWay}" Value="True"/>
                                            <Condition Binding="{Binding Path=HasDescription}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsOpen" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Popup.Style>
                        <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.Background>
                            <TextBlock Margin="10" Text="{Binding Path=Description}" Foreground="#f2f2f2" TextWrapping="Wrap" FontSize="18" VerticalAlignment="Center" />
                        </Border>
                    </Popup>
                    <TextBlock Name="Desc" Margin="5,0,5,2" TextWrapping="Wrap" Grid.Row="3" Height="50" TextTrimming="WordEllipsis" Background="Transparent" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=Description}"/>
                    <StackPanel Grid.Row="6" Margin="0,0,0,5"  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Background="Transparent" Name="DateAddedPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HasUpdates}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <fa5:ImageAwesome Name="DateAddedIcon" Margin="0,0,5,0" Height="15" Icon="Solid_Plus" Foreground="#f2f2f2"/>
                            <TextBlock Name="DateAddedText" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=DateAddedFormatted}" />
                        </StackPanel>
                        <StackPanel Background="Transparent" Name="DateUpdatedPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"  >
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=HasUpdates}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <fa5:ImageAwesome Name="DateUpdatedIcon" Margin="0,0,5,0" Height="15" Icon="Solid_Sync" Foreground="#f2f2f2"/>
                            <TextBlock Name="DateUpdatedText" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#f2f2f2" Text="{Binding Path=DateUpdatedAgo}"/>
                        </StackPanel>
                    </StackPanel>
                    <Popup PlacementTarget="{Binding ElementName=DateAddedPanel}" HorizontalAlignment="Center" AllowsTransparency="True">
                        <Popup.Style>
                            <Style TargetType="Popup">
                                <Setter Property="IsOpen" Value="True"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DateAddedPanel}" Value="False"/>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DateAddedIcon}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DateAddedText}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsOpen" Value="False"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Popup.Style>
                        <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.Background>
                            <TextBlock Margin="10" Foreground="#f2f2f2" FontWeight="Medium" FontSize="18" VerticalAlignment="Center" Text="{Binding Path=DateAdded,StringFormat={}Added {0}}"/>
                        </Border>
                    </Popup>
                    <Popup PlacementTarget="{Binding ElementName=DateUpdatedPanel}" HorizontalAlignment="Center" AllowsTransparency="True">
                        <Popup.Style>
                            <Style TargetType="Popup">
                                <Setter Property="IsOpen" Value="True"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DateUpdatedPanel}" Value="False"/>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DateUpdatedIcon}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DateUpdatedText}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsOpen" Value="False"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Popup.Style>
                        <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.Background>
                            <TextBlock Margin="10" Foreground="#f2f2f2" FontWeight="Medium" FontSize="18" VerticalAlignment="Center" Text="{Binding Path=DateUpdated,StringFormat={}Updated {0}}"/>
                        </Border>
                    </Popup>
                    <Grid Grid.Row="4" Margin="5,0,5,0">
                        <StackPanel Name="StatPanel" Background="Transparent" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                            <fa5:ImageAwesome Name="DownloadIcon" Margin="0,0,5,0" Height="13" Icon="Solid_Download" Foreground="#888888"/>
                            <TextBlock Name="DownloadText" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#888888" Text="{Binding Path=DownloadString}" FontSize="11"/>
                            <fa5:ImageAwesome Name="LikeIcon" Margin="0,0,5,0" Height="13" Icon="Solid_Heart" Foreground="#888888"/>
                            <TextBlock Name="LikeText" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#888888" Text="{Binding Path=LikeString}" FontSize="11"/>
                            <fa5:ImageAwesome Name="ViewIcon" Margin="0,0,5,0" Height="13" Icon="Solid_Eye" Foreground="#888888"/>
                            <TextBlock Name="ViewText" Margin="0,0,0,0" VerticalAlignment="Center" Foreground="#888888" Text="{Binding Path=ViewString}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                    <Popup PlacementTarget="{Binding ElementName=StatPanel}" HorizontalAlignment="Center" AllowsTransparency="True">
                        <Popup.Style>
                            <Style TargetType="Popup">
                                <Setter Property="IsOpen" Value="True"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=StatPanel}" Value="False"/>
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DownloadIcon}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=DownloadText}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=LikeIcon}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=LikeText}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=ViewIcon}" Value="False" />
                                            <Condition Binding="{Binding IsMouseDirectlyOver, ElementName=ViewText}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsOpen" Value="False"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Popup.Style>
                        <Border CornerRadius="5" Panel.ZIndex="0" Margin="10">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.BorderBrush>
                            <Border.Background>
                                <SolidColorBrush Color="#101010" Opacity="0.9"/>
                            </Border.Background>
                            <TextBlock Margin="10" Foreground="#f2f2f2" FontWeight="Medium" FontSize="18" VerticalAlignment="Center" >
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:N0} Downloads • {1:N0} Likes • {2:N0} Views">
                                        <Binding Path="Downloads"/>
                                        <Binding Path="Likes"/>
                                        <Binding Path="Views"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </Popup>
                    <Grid Grid.Row="7" Margin="5,8,5,10">
                        <Button HorizontalAlignment="Center" Style="{StaticResource RoundedTopButton}"
                                Foreground="#f2f2f2" FontWeight="SemiBold" Height="28" Width="130"
                                Content="Download" IsEnabled="{Binding Path=Compatible}" Click="Download_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>
    <Grid>
        <StackPanel Panel.ZIndex="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Grid.ColumnSpan="5">
            <StackPanel Background="Transparent" Margin="0,0,5,0" Orientation="Horizontal" Name="DiscordButton" PreviewMouseLeftButtonDown="Discord_Click" Cursor="Hand">
                <fa5:ImageAwesome Icon="Brands_Discord" Height="27" Foreground="#f2f2f2"/>
                <TextBlock Text="Join the Discord!" FontSize="18" Margin="5" Background="Transparent" Foreground="#f2f2f2" FontWeight="Medium"/>
            </StackPanel>
            <TextBox BorderThickness="0" FontSize="18" Margin="5" Background="Transparent" BorderBrush="Transparent" IsReadOnly="True" Foreground="#f2f2f2" FontWeight="Medium" Name="Stats" />
        </StackPanel>
        <TabControl Grid.ColumnSpan="5" Background="#202020" BorderBrush="#353535">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="Spacer"
                                        Width="Auto" Height="Auto"
                                        Margin="0,0,0,0" Padding="0,0,0,0"
                                        BorderBrush="Transparent" BorderThickness="0">
                                    <Border x:Name="Border"
                                            Width="Auto" MinWidth="100" MinHeight="30"
                                            VerticalAlignment="Bottom"
                                            Background="#1d1d1d" BorderBrush="#353535" BorderThickness="0,0,0,0" CornerRadius="6,6,0,0"
                                            Cursor="Hand">
                                        <ContentPresenter x:Name="ContentSite"
                                                          Width="Auto" Height="Auto"
                                                          Margin="8,3,8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ContentSource="Header" TextElement.FontFamily="Arial" TextElement.FontWeight="Medium" TextElement.FontSize="15pt" TextElement.Foreground="#f2f2f2"/>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                     Value="True">
                                        <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#353535" />
                                    </Trigger>
                                    <Trigger Property="IsSelected"
                                     Value="True">
                                        <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#353535" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Name="ModManager" Selector.Selected="OnManagerTabSelected" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Header="Manage Mods">
                <TabItem.Content>
                    <Grid Name="MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="1.6*" MinHeight="100"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition MinHeight="100"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="GameBox" Width="0" Height="0" Margin="0" Visibility="Collapsed" SelectionChanged="GameBox_SelectionChanged" DropDownClosed="GameBox_DropDownClosed">
                            <ComboBoxItem IsSelected="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="../Assets/Icons/ggs.png" Width="27" Margin="4,0,10,0"/>
                                    <TextBlock Text="Guilty Gear -Strive-" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                        <ComboBox Style="{StaticResource RoundedTopComboBox}" Grid.Column="1" Margin="10,0,8,0" Name="LoadoutsBox" SelectionChanged="LoadoutsBox_SelectionChanged"/>
                        <Button Style="{StaticResource RoundedTopButton}" Name="EditLoadoutsButton" Margin="0,0,8,0" Grid.Column="2" Content="Edit Loadouts" Click="EditLoadouts_Click" />
                        <Button Style="{StaticResource RoundedTopButton}" Name="ConfigButton" Margin="0,0,8,0" Grid.Column="3" Content="Setup" Click="Setup_Click" />
                        <Button Style="{StaticResource LaunchButtonStyle}" Name="LaunchButton" Margin="0,0,8,0" Grid.Column="4" Content="Launch" Click="Launch_Click"/>
                        <ComboBox Style="{StaticResource RoundedTopComboBox}" Grid.Column="5" Margin="0,0,8,0" Name="LauncherOptionsBox" SelectionChanged="LauncherOptionsBox_SelectionChanged"/>
                        <Button Style="{StaticResource RoundedTopButton}" Name="OpenModsButton" Margin="0,0,8,0" Grid.Column="6" Content="Add Mods" Click="ModsFolder_Click"/>
                        <Button Style="{StaticResource RoundedTopButton}" Name="UpdateButton" Margin="0,0,8,0" Grid.Column="7" Content="Update Mods" Click="Update_Click"/>
                        <Button Style="{StaticResource RoundedTopButton}" Name="SyncModsButton" Margin="0,0,8,0" Grid.Column="8" Content="Sync Mods" Click="SyncMods_Click" ToolTip="Synchronize enabled mods with active mods in game ~mods folder"/>
                        <Button Style="{StaticResource RedDangerButtonStyle}" Name="ResetTagsButton" Margin="0,0,10,0" Grid.Column="9" Content="Reset Tags" Click="ResetAllTags_Click" ToolTip="Reset all mod tags to default categories"/>

                        <Grid Name="MiddleGrid" Grid.Row="1" Grid.ColumnSpan="10" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*" MinWidth="300"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*" MinWidth="240" MaxWidth="800"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sidebar Panel -->
                            <Border Grid.Column="0" Background="#1A1A1A" BorderThickness="0,0,1,0" BorderBrush="#2C2C2C">
                                <Grid x:Name="SidebarContainer" Width="64" ClipToBounds="True">
                                    <!-- Section Sidebar (thin vertical icon bar) -->
                                    <Grid x:Name="SectionPanel" Width="64" HorizontalAlignment="Left">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="SectionPanelTranslate" X="0"/>
                                        </Grid.RenderTransform>
                                        <ListBox x:Name="SectionSidebar" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 SelectionMode="Single"
                                                 PreviewMouseLeftButtonUp="SectionSidebar_ItemClicked">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="4,6"/>
                                                    <Setter Property="Margin" Value="4,4,4,0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                                                    </Trigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                                                                    </MultiDataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Center" ToolTip="{Binding Name}" Margin="0,3">
                                                        <Border CornerRadius="7" Width="28" Height="28" Background="#262626" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="2"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                                <fa5:ImageAwesome Icon="{Binding FaIcon}" Foreground="#E0E0E0" Height="14" Width="14"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- Mod count dot on bottom right of section icon (grey pill, white text) -->
                                                        <Border Background="#383838" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" MinWidth="13" Height="13" Padding="2,0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                Visibility="{Binding HasMods, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding ModCount}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- Category Sidebar (slides over sections) -->
                                    <Grid x:Name="CategoryPanel" Width="190" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="CategoryPanelTranslate" X="190"/>
                                        </Grid.RenderTransform>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#202020" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#2F2F2F">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Image x:Name="CategoryHeaderImage" Stretch="Uniform" Width="18" Height="18"
                                                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                                    <fa5:ImageAwesome x:Name="CategoryHeaderIcon" Icon="Solid_Tshirt" Height="14" Width="14" Foreground="#D32F2F"/>
                                                </Grid>
                                                <TextBlock x:Name="CategoryHeader" Text="Categories" Foreground="#f2f2f2" FontWeight="Bold" FontSize="13"/>
                                            </StackPanel>
                                        </Border>

                                        <ListBox Grid.Row="1" x:Name="CategorySidebar" Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 SelectionMode="Single"
                                                 PreviewMouseLeftButtonUp="CategorySidebar_ItemClicked">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,5"/>
                                                    <Setter Property="Margin" Value="4,2,4,0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="8,5">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#D32F2F"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                                                    </Trigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                                                                    </MultiDataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="7" Width="28" Height="28" Background="#282828" Margin="0,0,8,0">
                                                            <Grid>
                                                                <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="2"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                                <fa5:ImageAwesome Icon="{Binding FaIcon}" Foreground="#CCCCCC" Height="14" Width="14"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E0E0E0" FontSize="12"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Category count badge (grey, not red) -->
                                                        <Border Grid.Column="2" Background="#383838" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" MinWidth="16" Height="14" Padding="4,0"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasMods, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding ModCount}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Return Arrow Button (Always Visible at bottom) -->
                                        <Border Grid.Row="2" Background="#1C1C1C" BorderThickness="0,1,0,0" BorderBrush="#2C2C2C" Padding="6">
                                            <Button x:Name="BackButton" Style="{StaticResource RoundedTopButton}" Height="30" Click="BackButton_Click">
                                                <TextBlock Text="&lt;" Foreground="#D32F2F" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Mod List -->
                            <ListBox Grid.Column="1" x:Name="ModListView" Background="#181818" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0"
                                     HorizontalContentAlignment="Stretch"
                                     SelectionChanged="ModGrid_SelectionChanged"
                                     MouseDoubleClick="ModListView_MouseDoubleClick"
                                     ContextMenuOpening="ModListView_ContextMenuOpening">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernModContextMenu}">
                                        <MenuItem Header="Edit Tags" Click="EditTags_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_Tags" Foreground="#D32F2F" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Rename Mod" Click="EditItem_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_Edit" Foreground="#CCCCCC" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show in Explorer" Click="OpenItem_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_FolderOpen" Foreground="#CCCCCC" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource ModernContextMenuSeparator}"/>
                                        <MenuItem Header="Configure Paks" Click="ConfigurePaksItem_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_Cogs" Foreground="#A0A0A0" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Fetch Metadata" Click="FetchItem_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_CloudDownloadAlt" Foreground="#A0A0A0" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sync with Game Folder" Click="SyncMods_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_SyncAlt" Foreground="#A0A0A0" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource ModernContextMenuSeparator}"/>
                                        <MenuItem Header="Delete Mod" Click="DeleteItem_Click" Style="{StaticResource ModernContextMenuItem}">
                                            <MenuItem.Icon>
                                                <fa5:ImageAwesome Icon="Solid_TrashAlt" Foreground="#EF5350" Height="13" Width="13"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ModListItem_PreviewMouseRightButtonDown"/>
                                        <Setter Property="Margin" Value="6,3,6,0"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Background" Value="#242424"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding isGroupHeader}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#292929"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#383838"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding isChild}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1E1E1E"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2B2B2B"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Bd" Property="Background" Value="#242424"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4C4C4C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#484848"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5C5C5C"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="38">
                                            <!-- GROUP HEADER ROW (when isGroupHeader == true) -->
                                            <Grid Visibility="{Binding isGroupHeader, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Expander Chevron Toggle Button -->
                                                <Button Grid.Column="0" Click="GroupExpander_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,4,8,4" Margin="0" FocusVisualStyle="{x:Null}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid Width="16" Height="16">
                                                        <fa5:ImageAwesome Icon="Solid_ChevronDown" Foreground="#CCCCCC" Height="11" Width="11"
                                                                          Visibility="{Binding isExpanded, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                        <fa5:ImageAwesome Icon="Solid_ChevronRight" Foreground="#888888" Height="11" Width="11"
                                                                          Visibility="{Binding isExpanded, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                    </Grid>
                                                </Button>

                                                <!-- Group Icon -->
                                                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="5" Background="#2C2424" BorderBrush="#4A3434" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <fa5:ImageAwesome Icon="Solid_LayerGroup" Foreground="#EF5350" Height="12" Width="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Group Title & Subtext & Count Badge -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding displayName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                                        <Border Background="#333333" BorderBrush="#484848" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding childCountText}" Foreground="#B0B0B0" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding displaySubtext}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Tag bubbles for Group Header -->
                                                <ItemsControl Grid.Column="3" ItemsSource="{Binding TagItems}" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Cursor="Hand" Click="TagBubble_Click" Tag="{Binding Name}" Margin="3,0"
                                                                    ToolTip="{Binding Name}" FocusVisualStyle="{x:Null}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="TagCircle" CornerRadius="13" Width="26" Height="26"
                                                                                Background="#383838" BorderBrush="#4A4A4A" BorderThickness="1"
                                                                                SnapsToDevicePixels="True" ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="3"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                                       Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                                                <fa5:ImageAwesome Icon="{Binding FaIcon}" Foreground="#E0E0E0" Height="12" Width="12"
                                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                  Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="TagCircle" Property="Background" Value="#4A4A4A"/>
                                                                                <Setter TargetName="TagCircle" Property="BorderBrush" Value="#606060"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter TargetName="TagCircle" Property="Background" Value="#D32F2F"/>
                                                                                <Setter TargetName="TagCircle" Property="BorderBrush" Value="#D32F2F"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter TargetName="TagCircle" Property="Background" Value="#EF5350"/>
                                                                                <Setter TargetName="TagCircle" Property="BorderBrush" Value="#EF5350"/>
                                                                            </MultiDataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- REGULAR MOD / CHILD MOD ROW (when isGroupHeader == false) -->
                                            <Grid Visibility="{Binding isGroupHeader, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Tree branch connector for child mods -->
                                                <Border Grid.Column="0" Visibility="{Binding isChild, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" Margin="4,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="↳" Foreground="#D32F2F" FontSize="14" FontWeight="Bold" Margin="0,-2,0,0"/>
                                                </Border>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="1" Style="{StaticResource ModEnableCheckStyle}"
                                                          IsChecked="{Binding enabled, Mode=TwoWay}"
                                                          Checked="OnChecked" Unchecked="OnUnchecked"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <!-- Mod / Variant Title & Subtext -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding displayName}" Foreground="#f2f2f2" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding displaySubtext}" Foreground="#888" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Tag bubbles for Mod -->
                                                <ItemsControl Grid.Column="3" ItemsSource="{Binding TagItems}" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Cursor="Hand" Click="TagBubble_Click" Tag="{Binding Name}" Margin="3,0"
                                                                    ToolTip="{Binding Name}" FocusVisualStyle="{x:Null}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="TagCircle" CornerRadius="13" Width="26" Height="26"
                                                                                Background="#383838" BorderBrush="#4A4A4A" BorderThickness="1"
                                                                                SnapsToDevicePixels="True" ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="3"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                                       Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                                                <fa5:ImageAwesome Icon="{Binding FaIcon}" Foreground="#E0E0E0" Height="12" Width="12"
                                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                  Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="TagCircle" Property="Background" Value="#4A4A4A"/>
                                                                                <Setter TargetName="TagCircle" Property="BorderBrush" Value="#606060"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter TargetName="TagCircle" Property="Background" Value="#D32F2F"/>
                                                                                <Setter TargetName="TagCircle" Property="BorderBrush" Value="#D32F2F"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter TargetName="TagCircle" Property="Background" Value="#EF5350"/>
                                                                                <Setter TargetName="TagCircle" Property="BorderBrush" Value="#EF5350"/>
                                                                            </MultiDataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#262626" Cursor="SizeWE" ShowsPreview="False" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                            <!-- Preview Area -->
                            <Grid Grid.Column="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Image Margin="3,3,10,5" Name="Preview" Grid.Row="0" Panel.ZIndex="2"/>
                                <Image Margin="3,3,10,5" Name="PreviewBG" Grid.Row="0" Stretch="UniformToFill" Panel.ZIndex="1">
                                    <Image.BitmapEffect>
                                        <BlurBitmapEffect Radius="40"/>
                                    </Image.BitmapEffect>
                                </Image>
                                <RichTextBox FontSize="12" Padding="10" Grid.Row="1" Margin="3,5,10,3" Name="DescriptionWindow"
                                             Foreground="#F2F2F2" Background="#202020" BorderBrush="#424242"
                                             VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsDocumentEnabled="True" FontWeight="Medium"/>
                            </Grid>
                        </Grid>
                        <GridSplitter Grid.Row="2" Grid.ColumnSpan="10" HorizontalAlignment="Stretch" Height="10" Background="Transparent" />

                        <RichTextBox FontFamily="{StaticResource Monospace}" FontSize="12" Margin="10,3,10,10" Name="ConsoleWindow" Background="#202020" BorderBrush="#424242" ClipToBounds="False" Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Grid.ColumnSpan="10" TextChanged="ScrollToBottom">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem Name="ModBrowser" Selector.Selected="OnBrowserTabSelected" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Header="Browse Mods">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Media Panel Overlay (Lightbox) -->
                    <Grid Grid.RowSpan="3" Name="MediaPanel" Panel.ZIndex="100" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Darkened background: click to close -->
                        <Border Grid.RowSpan="2" Background="#0A0A0A" Opacity="0.96" Cursor="Hand" PreviewMouseLeftButtonUp="CloseMedia_Click"/>

                        <!-- Close button top right -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" Panel.ZIndex="10"
                                Click="CloseMedia_Click" Style="{StaticResource RoundIconButtonStyle}" Height="36" Width="36" ToolTip="Close (Esc)">
                            <fa5:ImageAwesome Icon="Solid_Times" Foreground="#F2F2F2" Height="14" Width="14"/>
                        </Button>

                        <!-- Main Enlarged Image & Navigation -->
                        <Grid Grid.Row="0" Margin="20,40,20,10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImageLeft_Click" Name="BigImageLeft"
                                    Style="{StaticResource RoundIconButtonStyle}" Height="44" Width="44" Margin="12,0" Panel.ZIndex="10">
                                <fa5:ImageAwesome Icon="Solid_ChevronLeft" Foreground="#FFFFFF" Height="16" Width="16"/>
                            </Button>
                            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" ClipToBounds="True" Background="#111111">
                                <Grid>
                                    <fa5:ImageAwesome Foreground="#D32F2F" Icon="Solid_Spinner" Height="40" Width="40" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                                    <Image Name="BigScreenshot" Stretch="Uniform" VerticalAlignment="Center" MaxHeight="600"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ImageRight_Click" Name="BigImageRight"
                                    Style="{StaticResource RoundIconButtonStyle}" Height="44" Width="44" Margin="12,0" Panel.ZIndex="10">
                                <fa5:ImageAwesome Icon="Solid_ChevronRight" Foreground="#FFFFFF" Height="16" Width="16"/>
                            </Button>
                        </Grid>

                        <!-- Bottom Caption Bar -->
                        <Border Grid.Row="1" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" Padding="20,12" Margin="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Name="BigImageTitle" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock Name="BigCaptionText" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" MaxWidth="800" TextAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Description Panel Overlay (Cover-flow gallery on top, text on bottom, solid opaque background) -->
                    <Grid Grid.RowSpan="3" Name="DescPanel" Panel.ZIndex="4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Solid Non-Transparent Background -->
                        <Border Grid.RowSpan="6" Background="#141414"/>

                        <!-- Header Row 0: Title and Submitter Info -->
                        <DockPanel Grid.Row="0" Margin="16,10,16,10" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Click="CloseDesc_Click" Style="{StaticResource RoundIconButtonStyle}" Width="28" Height="28" Margin="8,0,0,0">
                                <fa5:ImageAwesome Icon="Solid_Times" Foreground="#AAAAAA" Height="12" Width="12"/>
                            </Button>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Path=Title}" TextTrimming="CharacterEllipsis" Foreground="#F2F2F2" FontWeight="Bold" FontSize="18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="By " Foreground="#888888" FontSize="12"/>
                                    <TextBlock Text="{Binding Path=Owner.Name}" Foreground="#D32F2F" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Divider -->
                        <Border Grid.Row="1" Background="#262626"/>

                        <!-- Top Gallery Cover-Flow (Row 2): All images visible horizontally; selected is centered, bright, and larger -->
                        <Grid x:Name="ImagePanel" Grid.Row="2" Background="#181818" MinHeight="170" MaxHeight="245" Margin="0" Visibility="Collapsed">
                            <!-- Left Navigation Button -->
                            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Click="ImageLeft_Click" Name="ImageLeft"
                                    Style="{StaticResource RoundIconButtonStyle}" Height="34" Width="34" Margin="12,0" Panel.ZIndex="10">
                                <fa5:ImageAwesome Icon="Solid_ChevronLeft" Foreground="#FFFFFF" Height="12" Width="12"/>
                            </Button>

                            <!-- Gallery Carousel Container (Shows all images horizontally, selected is centered) -->
                            <ScrollViewer x:Name="GalleryScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" PanningMode="HorizontalOnly" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ItemsControl x:Name="GalleryItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6,6" CornerRadius="8" Cursor="Hand" PreviewMouseLeftButtonUp="GalleryItem_Click"
                                                    BorderThickness="1" SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="Height" Value="135"/>
                                                        <Setter Property="Width" Value="210"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                <Setter Property="Height" Value="180"/>
                                                                <Setter Property="Width" Value="290"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid ClipToBounds="True">
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Right Navigation Button -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ImageRight_Click" Name="ImageRight"
                                    Style="{StaticResource RoundIconButtonStyle}" Height="34" Width="34" Margin="12,0" Panel.ZIndex="10">
                                <fa5:ImageAwesome Icon="Solid_ChevronRight" Foreground="#FFFFFF" Height="12" Width="12"/>
                            </Button>

                            <!-- Bottom caption text -->
                            <TextBlock Name="CaptionText" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="11" Foreground="#BBBBBB" Margin="0,0,0,4" Panel.ZIndex="5"/>
                            <Image x:Name="Screenshot" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Divider -->
                        <Border Grid.Row="3" Background="#262626"/>

                        <!-- Text Description on Bottom (Row 4) -->
                        <RichTextBox Margin="16,10" Name="DescText" Grid.Row="4" Background="Transparent" BorderThickness="0"
                                     IsDocumentEnabled="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                                     Foreground="#E0E0E0" Padding="6" FontSize="13"/>

                        <!-- Action Buttons Bar (Row 5) -->
                        <Border Grid.Row="5" Background="#181818" BorderThickness="0,1,0,0" BorderBrush="#252525" Padding="16,10">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Name="AltButton" Click="AltDownload_Click" Content="Alt. Downloads" IsEnabled="{Binding Path=Compatible}" Margin="0,0,8,0"
                                            Style="{StaticResource RoundedTopButton}" Height="30" Width="120" FontSize="12"/>
                                    <Button Name="DownloadButton" Click="Download_Click" Content="Download" IsEnabled="{Binding Path=Compatible}" Margin="0,0,8,0"
                                            Style="{StaticResource LaunchButtonStyle}" Height="30" Width="120" FontSize="12"/>
                                    <!-- Installed Badge (to the right of Download button) -->
                                    <Border Name="InstalledBadge" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Background="#1B3E20" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="15" Height="30" Padding="8,0,12,0"
                                            Visibility="{Binding IsInstalled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                            ToolTip="This mod is installed in Striverum">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#4CAF50" CornerRadius="8" Width="16" Height="16" Margin="0,0,6,0">
                                                <fa5:ImageAwesome Icon="Solid_Check" Height="9" Width="9" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Installed" FontSize="12" FontWeight="SemiBold" Foreground="#81C784" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Name="HomepageButton" Click="Homepage_Click" Margin="0,0,8,0"
                                            Style="{StaticResource RoundedTopButton}" Height="30" Width="120" FontSize="12"/>
                                    <Button Click="CloseDesc_Click" Content="Close"
                                            Style="{StaticResource RoundedTopButton}" Height="30" Width="90" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Top Toolbar Row 0: Search, NSFW, Sort, Refresh | Pagination -->
                    <DockPanel Grid.Row="0" Margin="10,8,10,4" LastChildFill="False">
                        <!-- Left controls -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Search Bar (Rounded pill) -->
                            <Grid Width="220" Height="28" Margin="0,0,8,0">
                                <TextBox Name="SearchBar" Style="{x:Null}" Height="28"
                                         Background="#222222" Foreground="#F2F2F2" BorderBrush="#383838" BorderThickness="1"
                                         Padding="10,0,28,0" VerticalContentAlignment="Center" FontSize="12"
                                         IsEnabled="False" KeyDown="SearchBar_KeyDown">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="14"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <TextBlock Margin="12,0,28,0" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Text="Search mods..." Foreground="#777777" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=SearchBar, Path=Text.IsEmpty}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button HorizontalAlignment="Right" Click="SearchButton_Click" Name="SearchButton"
                                        Width="26" Height="26" Margin="0,1,1,1" IsEnabled="False"
                                        Style="{StaticResource RoundIconButtonStyle}" Background="Transparent" BorderThickness="0">
                                    <fa5:ImageAwesome Icon="Solid_Search" Foreground="#A0A0A0" Height="11" Width="11"/>
                                </Button>
                            </Grid>

                            <!-- NSFW Pill Toggle -->
                            <CheckBox Name="NSFWCheckbox" Style="{StaticResource NsfwPillStyle}"
                                      IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Unchecked="NSFWCheckbox_Checked" Checked="NSFWCheckbox_Checked"/>

                            <!-- Filter/Sort Dropdown -->
                            <ComboBox Name="FilterBox" Style="{StaticResource RoundedTopComboBox}"
                                      Width="130" Height="28" Margin="0,0,8,0" IsEnabled="False"
                                      SelectionChanged="FilterSelectionChanged"/>

                            <!-- Refresh/ClearCache Button -->
                            <Button Name="ClearCacheButton" Style="{StaticResource RoundIconButtonStyle}"
                                    Width="28" Height="28" Margin="0,0,8,0" ToolTip="Refresh"
                                    IsEnabled="False" Click="ClearCache">
                                <fa5:ImageAwesome Icon="Solid_SyncAlt" Foreground="#CCCCCC" Height="12" Width="12"/>
                            </Button>
                        </StackPanel>

                        <!-- Right controls: Download Queue Progress + Pagination -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Download Queue Progress Panel (Visible only when downloading/queued) -->
                            <Border Name="DownloadQueuePanel" Visibility="Collapsed" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="14" Height="28" Margin="0,0,12,0" Padding="10,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <fa5:ImageAwesome Name="QueueStatusIcon" Icon="Solid_ArrowDown" Height="11" Width="11" Foreground="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <!-- Mod count: current/total (e.g. 1/3) -->
                                    <TextBlock Name="QueueCountText" Text="1/1" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Progress bar -->
                                    <ProgressBar Name="QueueProgressBar" Width="110" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Background="#2A2A2A" Foreground="#E53935" BorderThickness="0">
                                        <ProgressBar.Resources>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                                                                <Grid>
                                                                    <Border Name="PART_Track"/>
                                                                    <Border Name="PART_Indicator" Background="#E53935" CornerRadius="4" HorizontalAlignment="Left"/>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ProgressBar.Resources>
                                    </ProgressBar>
                                    <!-- Size progress: downloaded / total -->
                                    <TextBlock Name="QueueSizeText" Text="0 MB / 0 MB" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Name="PageLeft" Style="{StaticResource RoundIconButtonStyle}"
                                    Width="28" Height="28" Margin="0,0,6,0" IsEnabled="False"
                                    Click="DecrementPage" ToolTip="Previous page">
                                <fa5:ImageAwesome Icon="Solid_ChevronLeft" Foreground="#CCCCCC" Height="10" Width="10"/>
                            </Button>
                            <TextBlock Name="Page" Text="Page 1 / 1" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <Button Name="PageRight" Style="{StaticResource RoundIconButtonStyle}"
                                    Width="28" Height="28" Margin="0,0,8,0" IsEnabled="False"
                                    Click="IncrementPage" ToolTip="Next page">
                                <fa5:ImageAwesome Icon="Solid_ChevronRight" Foreground="#CCCCCC" Height="10" Width="10"/>
                            </Button>
                            <ComboBox Name="PageBox" Style="{StaticResource RoundedTopComboBox}"
                                      Width="65" Height="28" IsEnabled="False" ToolTip="Jump to page"
                                      SelectionChanged="PageBox_SelectionChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Top Toolbar Row 1: Horizontal Filter Bar (Sections & Subcategories) + Per Page + GameBanana -->
                    <DockPanel Grid.Row="1" Margin="10,0,10,8" LastChildFill="True">
                        <!-- Right controls: Per Page + GameBanana + Hidden Legacy ComboBoxes -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Hidden ComboBoxes kept for logic state bindings -->
                            <ComboBox Name="TypeBox" Visibility="Collapsed">
                                <ComboBoxItem xml:space="preserve" IsSelected="True">Mods</ComboBoxItem>
                                <ComboBoxItem xml:space="preserve">WiPs</ComboBoxItem>
                                <ComboBoxItem xml:space="preserve">Sounds</ComboBoxItem>
                            </ComboBox>
                            <ComboBox Name="CatBox" Visibility="Collapsed"/>
                            <ComboBox Name="SubCatBox" Visibility="Collapsed"/>
                            <!-- Hidden GameFilterBox kept for code-behind bindings -->
                            <ComboBox Margin="0" Width="0" Height="0" Visibility="Collapsed" IsEnabled="False" Name="GameFilterBox">
                                <ComboBoxItem>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="../Assets/Icons/ggs.png" Width="27" Margin="4,0,10,0"/>
                                        <TextBlock Text="Guilty Gear -Strive-" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            <!-- Hidden SZFilters kept for code-behind -->
                            <StackPanel x:Name="SZFilters" Visibility="Collapsed" Orientation="Horizontal">
                                <CheckBox Name="ZsJsonCheckbox" IsEnabled="False" Unchecked="ZsJsonCheckbox_Checked" Checked="ZsJsonCheckbox_Checked"/>
                                <CheckBox Name="ColorZCheckbox" IsEnabled="False" Unchecked="ColorZCheckbox_Checked" Checked="ColorZCheckbox_Checked"/>
                            </StackPanel>

                            <TextBlock Margin="8,0,6,0" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Per Page:"/>
                            <ComboBox Name="PerPageBox" Style="{StaticResource RoundedTopComboBox}"
                                      Width="70" Height="28" Margin="0,0,10,0" IsEnabled="False"
                                      SelectionChanged="PerPageSelectionChanged">
                                <ComboBoxItem>10</ComboBoxItem>
                                <ComboBoxItem IsSelected="True">20</ComboBoxItem>
                                <ComboBoxItem>30</ComboBoxItem>
                                <ComboBoxItem>40</ComboBoxItem>
                                <ComboBoxItem>50</ComboBoxItem>
                            </ComboBox>

                            <!-- GameBanana Logo -->
                            <Image Name="GB" Height="26" Width="26" VerticalAlignment="Center" Cursor="Hand"
                                   Source="../Assets/GameBanana.png" MouseLeftButtonDown="GameBanana_Click"/>
                            <Popup PlacementTarget="{Binding ElementName=GB}" IsOpen="{Binding IsMouseDirectlyOver, ElementName=GB, Mode=OneWay}" AllowsTransparency="True">
                                <Border CornerRadius="6" Background="#181818" BorderBrush="#383838" BorderThickness="1" Margin="8" Padding="8,4">
                                    <TextBlock Text="Go to gamebanana.com" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!-- Left / Center: Horizontal Section & Category Bar with Smooth In-Place Slide Transition -->
                        <ScrollViewer x:Name="BrowseFilterScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" PanningMode="HorizontalOnly" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <!-- View 1: Section Filter Buttons (All, Skins, Sounds, WiPs, Other/Misc, GUIs, Gameplay, Stages) -->
                                <StackPanel x:Name="BrowseSectionPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="BrowseSectionTranslate" X="0"/>
                                    </StackPanel.RenderTransform>
                                    <ItemsControl x:Name="BrowseSectionBar">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,0" CornerRadius="14" Height="28" Padding="10,0" Cursor="Hand"
                                                        PreviewMouseLeftButtonUp="BrowseSectionButton_Click" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#222222"/>
                                                            <Setter Property="BorderBrush" Value="#383838"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                                    <Setter Property="BorderBrush" Value="#E53935"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#353535"/>
                                                                </Trigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconPath}" Height="16" Width="16" Margin="0,0,6,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                        <fa5:ImageAwesome Icon="{Binding FaIcon}" Foreground="#F2F2F2" Height="12" Width="12" Margin="0,0,6,0"
                                                                          Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                        <!-- Section Mod Count Badge -->
                                                        <Border Background="#383838" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" MinWidth="16" Height="14" Padding="4,0"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasMods, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding ModCount}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- View 2: Subcategory / Character Pills Bar (Opens in place of sections with smooth animation) -->
                                <StackPanel x:Name="BrowseCategoryPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="BrowseCategoryTranslate" X="30"/>
                                    </StackPanel.RenderTransform>
                                    <!-- Back button to return to sections -->
                                    <Button x:Name="BrowseBackButton" Height="28" Width="30" Margin="0,0,6,0"
                                            Style="{StaticResource RoundIconButtonStyle}" Click="BrowseBackButton_Click" ToolTip="Back to Sections">
                                        <TextBlock Text="&lt;" Foreground="#D32F2F" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                    </Button>

                                    <!-- Section Badge / Indicator button (clicking shows all mods for the section) -->
                                    <Border x:Name="BrowseSectionBadge" Margin="0,0,6,0" CornerRadius="14" Height="28" Padding="10,0" Cursor="Hand"
                                            Background="#262626" BorderBrush="#383838" BorderThickness="1" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonUp="BrowseSectionBadge_Click" ToolTip="Show all in this section">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#353535"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image x:Name="BrowseCurrentSectionImage" Height="16" Width="16" Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                            <fa5:ImageAwesome x:Name="BrowseCurrentSectionIcon" Foreground="#F2F2F2" Height="12" Width="12" Margin="0,0,6,0" Visibility="Collapsed"/>
                                            <TextBlock x:Name="BrowseCurrentSectionTitle" Foreground="#F2F2F2" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            <Border Background="#383838" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" MinWidth="16" Height="14" Padding="4,0"
                                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="BrowseCurrentSectionCount" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Divider between section badge and subcategories -->
                                    <Border Width="1" Height="18" Background="#383838" Margin="2,0,8,0" VerticalAlignment="Center"/>

                                    <!-- Subcategory / Character Pills -->
                                    <ItemsControl x:Name="BrowseCategoryPillsBar">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,5,0" CornerRadius="13" Height="26" Padding="8,0" Cursor="Hand"
                                                        PreviewMouseLeftButtonUp="BrowseCategoryPill_Click" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1C1C1C"/>
                                                            <Setter Property="BorderBrush" Value="#303030"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                                    <Setter Property="BorderBrush" Value="#E53935"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#2E2E2E"/>
                                                                </Trigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconPath}" Height="15" Width="15" Margin="0,0,5,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                                        <fa5:ImageAwesome Icon="{Binding FaIcon}" Foreground="#E0E0E0" Height="11" Width="11" Margin="0,0,5,0"
                                                                          Visibility="{Binding HasImage, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Inverse}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                        <!-- Category Mod Count Badge -->
                                                        <Border Background="#383838" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" MinWidth="15" Height="13" Padding="3,0"
                                                                Margin="5,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasMods, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding ModCount}" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Row 2: Mod Feed & Status Indicators -->
                    <Border Grid.Row="2" CornerRadius="6" Margin="10,0,10,10" Background="#141414" BorderBrush="#252525" BorderThickness="1">
                        <ListView Margin="4" Panel.ZIndex="1" Style="{StaticResource ListviewStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" BorderBrush="Transparent" Name="FeedBox" ItemTemplate="{StaticResource ModTemplate}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="false"/>
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid SizeChanged="UniformGrid_SizeChanged"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Border>

                    <fa5:ImageAwesome Name="LoadingBar" Grid.Row="2" Foreground="#D32F2F" Panel.ZIndex="2" Icon="Solid_Spinner" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center" Spin="True" SpinDuration="2"/>
                    <StackPanel Name="ErrorPanel" Grid.Row="2" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="BrowserMessage" HorizontalAlignment="Center" Background="Transparent" Foreground="#F2F2F2" FontWeight="SemiBold" TextWrapping="Wrap" Width="600" TextAlignment="Center" FontSize="18"/>
                        <Button Margin="12" Click="BrowserRefresh" Name="BrowserRefreshButton" Style="{StaticResource RoundedTopButton}" Height="30" Width="120" Content="Retry"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>



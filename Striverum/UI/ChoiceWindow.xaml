<Window x:Class="Striverum.UI.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Striverum.UI"
        xmlns:root="clr-namespace:Striverum"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        Title="Striverum" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Width="460"
        Background="#181818" ShowActivated="True" Closing="Window_Closing" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <Button Click="SelectButton_Click" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBorder" Background="#242424" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="14,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon container -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasIcon, Converter={x:Static root:BoolToVisibilityConverter.Instance}}">
                                    <fa5:ImageAwesome Icon="{Binding FaIcon}" Height="15" Width="15" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Text content -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Name="OptionText" FontSize="14" FontWeight="SemiBold" Foreground="#F2F2F2" Margin="0,0,0,3" Text="{Binding Path=OptionText}"/>
                                    <TextBlock Name="OptionSubText" FontSize="12" TextWrapping="Wrap" Foreground="#888888" Text="{Binding Path=OptionSubText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2E2E2E"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2C2C2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Margin="0,2,0,14" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa5:ImageAwesome x:Name="HeaderIcon" Icon="Solid_SlidersH" Height="15" Width="15" Foreground="#D32F2F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="Bold" Foreground="#F2F2F2" Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Choices list -->
        <ListView MaxHeight="500" Name="ChoiceList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ChoiceTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Cancel button -->
        <Button Grid.Row="2" Name="CancelButton" Height="34" Margin="0,4,0,0" Cursor="Hand" Click="CancelButton_Click" IsCancel="True">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="CancelBorder" Background="#222222" BorderBrush="#383838" BorderThickness="1" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <fa5:ImageAwesome Icon="Solid_Times" Height="11" Width="11" Foreground="#A0A0A0" Margin="0,0,6,0"/>
                            <TextBlock Text="Cancel" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CancelBorder" Property="Background" Value="#333333"/>
                            <Setter TargetName="CancelBorder" Property="BorderBrush" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CancelBorder" Property="Background" Value="#1A1A1A"/>
                            <Setter TargetName="CancelBorder" Property="BorderBrush" Value="#2C2C2C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
